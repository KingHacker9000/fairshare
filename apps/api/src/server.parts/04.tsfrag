     FROM expenses e JOIN users u ON u.id = e.paid_by_user_id WHERE e.group_id = ? AND e.deleted_at IS NULL ORDER BY e.incurred_at`,
  ).all(groupId) as any[];
  const escape = (value: unknown) => `"${String(value ?? '').replaceAll('"', '""')}"`;
  const csv = [
    ['Description', 'Category', 'Amount', 'Currency', 'Date', 'Paid by'].map(escape).join(','),
