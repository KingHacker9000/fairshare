{
  "name": "@fairshare/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/assemble-server.mjs && tsx watch src/server.generated.ts",
    "build": "node scripts/assemble-server.mjs && tsc -p tsconfig.json && cp src/schema.sql dist/schema.sql",
    "start": "node dist/server.generated.js",
    "seed": "tsx src/seed.ts",
    "typecheck": "node scripts/assemble-server.mjs && tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "node scripts/assemble-server.mjs && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fairshare/shared": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "better-sqlite3": "13.0.1",
    "fastify": "5.10.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.2.0",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3"
  }
}
