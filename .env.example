NODE_ENV=development
PORT=8080
DATABASE_PATH=/data/fairshare.db
UPLOAD_DIR=/data/uploads
JWT_SECRET=replace-with-at-least-32-random-bytes
APP_ORIGIN=http://localhost:8081
FX_PROVIDER_URL=https://api.frankfurter.app

# Free/default receipt scanner: Tesseract + deterministic receipt reconciliation on your own server.
OCR_PROVIDER=local
TESSERACT_LANG=eng

# Optional only. Leave blank unless you explicitly want a paid vision fallback later.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4.1-mini
