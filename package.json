{
  "name": "fairshare",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @fairshare/api --filter @fairshare/app dev",
    "dev:api": "pnpm --filter @fairshare/api dev",
    "dev:app": "pnpm --filter @fairshare/app dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build && pnpm -r test",
    "lint": "pnpm -r lint"
  }
}
